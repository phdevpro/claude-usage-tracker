@echo off
rem Claude usage agent - self installer for Windows, generated by the server at
rem __SERVER__ with its URL and agent token built in. Keep it private.
rem   Double-click it to install, send once and schedule every 30 minutes.
rem   Run "claude-usage-agent-windows.cmd uninstall" to remove it again.
rem The PowerShell part below the marker line does the work.
set "CUA_SELF=%~f0"
set "CUA_ARGS=%*"
powershell -NoProfile -ExecutionPolicy Bypass -Command "iex ((Get-Content -LiteralPath $env:CUA_SELF -Raw) -split ('#' + '#PS1' + '##'), 2)[1]"
echo.
pause
exit /b
###PS1##
$ErrorActionPreference = "Stop"
$taskName = "Claude usage agent"
$dir = Join-Path $env:LOCALAPPDATA "ClaudeUsageAgent"
$log = Join-Path $env:USERPROFILE ".claude\usage-agent.log"

try {
    if ($env:CUA_ARGS -match "uninstall") {
        Unregister-ScheduledTask -TaskName $taskName -Confirm:$false -ErrorAction SilentlyContinue
        Remove-Item -Recurse -Force $dir -ErrorAction SilentlyContinue
        Write-Host "Claude usage agent removed (log kept at $log)."
        return
    }

    # the py launcher first: "python" may be the Microsoft Store stub that only opens the Store
    $python = $null
    foreach ($cand in @("py -3", "python")) {
        $c = $cand -split " "
        if (-not (Get-Command $c[0] -ErrorAction SilentlyContinue)) { continue }
        $exe = & $c[0] @($c | Select-Object -Skip 1) -c "import sys; print(sys.executable if sys.version_info >= (3, 9) else '')" 2>$null
        if ($LASTEXITCODE -eq 0 -and $exe) { $python = "$exe".Trim(); break }
    }
    if (-not $python) { throw "Python 3.9 or newer is needed: install it from https://www.python.org/downloads/ and run this again." }
    $pythonw = Join-Path (Split-Path $python) "pythonw.exe"
    if (-not (Test-Path $pythonw)) { throw "pythonw.exe not found next to $python" }

    New-Item -ItemType Directory -Force $dir | Out-Null
    $script = Join-Path $dir "claude_usage_agent.py"
    [IO.File]::WriteAllBytes($script, [Convert]::FromBase64String("__AGENT_B64__"))
    [IO.File]::WriteAllBytes((Join-Path $dir "agent.json"), [Convert]::FromBase64String("__CONFIG_B64__"))

    Write-Host "Installed to $dir - sending usage once now..."
    & $python $script
    if ($LASTEXITCODE -ne 0) { Write-Warning "First send failed (see above); the scheduled task will retry." }

    $action = New-ScheduledTaskAction -Execute $pythonw -Argument "`"$script`" --log `"$log`""
    $trigger = New-ScheduledTaskTrigger -Once -At (Get-Date).AddMinutes(1) -RepetitionInterval (New-TimeSpan -Minutes 30)
    $settings = New-ScheduledTaskSettingsSet -StartWhenAvailable -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries `
        -ExecutionTimeLimit (New-TimeSpan -Minutes 10) -MultipleInstances IgnoreNew
    Register-ScheduledTask -TaskName $taskName -Action $action -Trigger $trigger -Settings $settings -Force `
        -Description "Sends Claude Code token usage to __SERVER__ every 30 minutes" | Out-Null
    Write-Host "Scheduled '$taskName' every 30 minutes. Log: $log"
} catch {
    Write-Host "Install failed: $_" -ForegroundColor Red
}
