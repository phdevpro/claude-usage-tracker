# Claude usage tracker – stack environment (paste into Portainer → Stack → Environment variables)

# Public host name routed by Traefik (DNS record must point to the Traefik host)
USAGE_HOST=claude-usage.example.com
USAGE_VERSION=latest

# Optional: host/NFS path for the data; leave unset to use the named volume
# USAGE_DATA_LOCATION=/mnt/nas/claude-usage

# Shared secret the agents send. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_TOKEN=change-me

# Dashboard login (HTTP Basic auth, protected by Traefik's HTTPS)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me
